# Copy to .env.local for local development. Never commit .env.local.

# Server-side only. Read by @anthropic-ai/sdk. On Fly: `fly secrets set ANTHROPIC_API_KEY=...`
ANTHROPIC_API_KEY=

# Claude model id. Runtime. Default is Sonnet 5.
ANTHROPIC_MODEL=claude-sonnet-5

# Assistant logging. 0 = nothing (production default), 1 = kinds + token usage, 2 = also question text (dev default).
ASK_LOG=

# Public origin. BUILD-TIME: baked into metadata and canonical URLs by `next build`; a domain change needs a rebuild.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
