{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "pregenerate": "tsx --conditions=react-server scripts/pregenerate.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "deploy:staging": "fly deploy -c fly.staging.toml --remote-only --ha=false",
    "deploy:prod": "fly deploy -c fly.toml --remote-only --ha=false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "next": "15.5.25",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.17 <23"
  }
}
